# --- Database (PostgreSQL only) ---------------------------------------------
# Local development: `npm run db:dev` starts a disposable PostgreSQL on port 5433 (no Docker needed):
DATABASE_URL="postgresql://director:director_dev_local@127.0.0.1:5433/director?schema=public"
# Production: an RDS/PostgreSQL 14+ URL, e.g. postgresql://user:password@host:5432/director?schema=public&sslmode=require

# --- Auth --------------------------------------------------------------------
# 32+ random characters. Production refuses to start with a short or placeholder value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Companies House (https://developer.company-information.service.gov.uk/) --
# Never commit real values. Keep them in .env (gitignored) or AWS Secrets Manager.
COMPANIES_HOUSE_API_KEY=""
COMPANIES_HOUSE_STREAM_KEY=""

# --- Calendar OAuth ----------------------------------------------------------
# Encrypts OAuth calendar tokens at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""
# Google Calendar (optional; lets each user push their follow-ups to their OWN Google Calendar). One-time setup by an admin:
#  1. Google Cloud Console > create/select a project > APIs & Services > enable "Google Calendar API".
#  2. OAuth consent screen: app name, support email; add the scopes .../auth/calendar and .../auth/userinfo.email.
#     While the app is in "Testing", only the listed test users can connect; for everyone, publish it (the calendar scope is
#     "sensitive", so Google asks for verification for public apps).
#  3. Credentials > Create OAuth client ID > "Web application". Authorised redirect URI must equal GOOGLE_CALENDAR_REDIRECT_URI
#     below EXACTLY (production: https://<your-domain>/api/calendar/callback/google).
#  4. Put the client ID and secret here (or in your secrets manager) and restart. The Connect button then enables itself.
# Without all four of CLIENT_ID, CLIENT_SECRET, REDIRECT_URI and TOKEN_ENCRYPTION_KEY, Settings shows "Not configured".
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/calendar/callback/google"

# --- Behaviour (all optional) ------------------------------------------------
# Show synthetic development companies in search/reports/exports.
# Unset = visible in development, hidden in production.
# SEED_DATA_VISIBLE="false"
# Export row caps per role
# EXPORT_MAX_ROWS_USER="50000"
# EXPORT_MAX_ROWS_ADMIN="250000"
# EXPORT_MAX_ROWS_SUPER="1000000"
# Login throttling: failed attempts per 15 minutes
# LOGIN_MAX_ATTEMPTS_PER_ACCOUNT="8"
# LOGIN_MAX_ATTEMPTS_PER_IP="40"
# Ingestion outcome thresholds (error+skip rate): <= success max => success, <= partial max => partial, else failed
# INGEST_SUCCESS_MAX_ERROR_RATE="0.001"
# INGEST_PARTIAL_MAX_ERROR_RATE="0.05"
# Stream: store every filing type instead of only DS01/DS02 (large!)
# STREAM_STORE_ALL="1"
# Officer coverage pipeline (see README "Officer coverage"). All optional; defaults shown.
# Dedicated worker: npm run ch:officer-worker -- --limit 500  (the daily update only enqueues)
# OFFICER_WORKER_BATCH="25"             # jobs claimed per loop
# OFFICER_ENQUEUE_CAP="2000"            # max companies one request / report / followed list may queue
# OFFICER_MAX_ATTEMPTS="6"              # company-specific failures before a job is parked
# OFFICER_LEASE_MINUTES="5"             # a dead worker's jobs return to the queue after this
# OFFICER_STALE_AFTER_DAYS="180"        # confirmed data older than this is "stale" and re-fetched
# OFFICER_SOFT_REFRESH_DAYS="30"        # a detail-page view of older data queues a background refresh
# OFFICER_UNAVAILABLE_RECHECK_DAYS="90" # re-check companies Companies House had no officer data for
# Scheduler: run the officer worker alongside (queued work only); the crawl is a separate opt-in
# OFFICER_WORKER_ENABLED="1"
# OFFICER_CRAWL_ENABLED="1"
# Shared Companies House quota gate (documented ceiling: 600 requests / 5 minutes per key)
# CH_QUOTA_LIMIT="600"
# CH_QUOTA_WINDOW_SECONDS="300"
# CH_QUOTA_HEADROOM="30"                # never spent: left for other callers sharing the key
# CH_QUOTA_RESERVE_USER="120"           # per-window reservations (policy, not a guarantee):
# CH_QUOTA_RESERVE_FILING="60"          #   user > filing > stream > refresh > backfill;
# CH_QUOTA_RESERVE_STREAM="60"          #   the backfill is always the first to yield
# CH_QUOTA_RESERVE_REFRESH="80"
# CH_QUOTA_RESERVE_BACKFILL="250"
# Demand-aware: the reservations above are guaranteed only to a class that asked for quota within the
# last CH_QUOTA_DEMAND_HORIZON_SECONDS; an idle class holds back just its floor, so the background crawl
# can use the idle capacity (default 600-30-90 = 480 per 5 min) and yields as soon as others show demand.
# CH_QUOTA_FLOOR_USER="40"
# CH_QUOTA_FLOOR_FILING="15"
# CH_QUOTA_FLOOR_STREAM="15"
# CH_QUOTA_FLOOR_REFRESH="20"
# CH_QUOTA_DEMAND_HORIZON_SECONDS="120"
# CH_QUOTA_PACING="1"                   # 0 = send background requests in bursts again (old behaviour)
# CH_QUOTA_PACE_BURST="10"              # background requests allowed immediately at the start of a window
# CH_QUOTA_PACE_MAX_INLINE_SECONDS="10" # longest pacing delay absorbed inside a call
# Circuit breakers
# CH_AUTH_BREAKER_THRESHOLD="2"         # consecutive 401/403 that stop all REST traffic
# CH_AUTH_PROBE_MINUTES="60"            # cool-off before one half-open probe request
# CH_OUTAGE_WINDOW="20"                 # 5xx/network failures > 50% of this many calls pause background work
# CH_OUTAGE_BACKOFF_MINUTES="5"         # doubles per trip, max 60
# Built-in scheduler (npm run jobs:scheduler)
# DAILY_UPDATE_UTC_HOUR="3"
# New registrations sync is ON whenever COMPANIES_HOUSE_API_KEY is set; set to "0" to turn it off, or change the interval
# NEW_REGISTRATIONS_ENABLED="0"
# NEW_REGISTRATIONS_INTERVAL_HOURS="6"
# MONTHLY_INGEST_ENABLED="1"
# MONTHLY_INGEST_DAY="3"
# MONTHLY_INGEST_UTC_HOUR="4"
