DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Companies House REST API + filing stream (https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=""
COMPANIES_HOUSE_STREAM_KEY=""

# Encrypts OAuth calendar tokens at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# Google Calendar OAuth (Google Cloud Console — see README "Manual setup")
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/calendar/callback/google"
